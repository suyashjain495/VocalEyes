<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="true" />

    <application
        android:name=".VocalEyesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VocalEyesNew"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        tools:targetApi="31">
        <activity
            android:name=".EnhancedMainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VocalEyesNew"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".objectdetection.ObjectDetectionActivity"
            android:exported="false"
            android:theme="@style/Theme.VocalEyesNew" />

        <activity
            android:name=".textextraction.TextExtractionActivity"
            android:exported="false"
            android:theme="@style/Theme.VocalEyesNew"
            android:screenOrientation="portrait" />


        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.VocalEyesNew" />

        <activity
            android:name=".navigation.NavigationActivity"
            android:exported="false"
            android:theme="@style/Theme.VocalEyesNew"
            android:screenOrientation="portrait" />

        <activity
            android:name=".facenet_android.FaceActivity"
            android:exported="false"
            android:theme="@style/Theme.VocalEyesNew"
            android:screenOrientation="portrait" />

        <activity
            android:name=".facenet_android.FaceMainActivity"
            android:exported="false"
            android:theme="@style/Theme.VocalEyesNew"
            android:screenOrientation="portrait" />

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="lang" />

        <meta-data
            android:name="androidx.camera.provider.DefaultCameraXConfig"
            android:value="androidx.camera.camera2.Camera2Config$DefaultProvider" />
    </application>

</manifest>